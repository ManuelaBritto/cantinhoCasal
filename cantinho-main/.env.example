# Copie este arquivo para .env e preencha o que for usar.
# O .env NÃO deve ir para o repositório (já está no .gitignore).

# Porta do servidor local
PORT=5173

# --- Supabase (opcional) ---
# Painel do Supabase > Project Settings > API
# Use SOMENTE a "Project URL" e a chave pública: "publishable" (sb_publishable_...) ou "anon public".
# NUNCA a secret (sb_secret_...) nem a service_role.
SUPABASE_URL=https://zbyjnjcebfnsyplsddyr.supabase.co
SUPABASE_ANON_KEY=sb_publishable_oBMyDwQJT5T1BgWuEMrUOw_w25-6IPi

# Login por NOME: o site transforma "Kath" em kath@<LOGIN_DOMINIO> por trás.
# Crie as contas no Supabase exatamente com esses e-mails (ex.: kath@nossocantinho.app).
LOGIN_DOMINIO=nossocantinho.app

# --- TMDB (opcional) ---
# https://www.themoviedb.org/settings/api
# Preencha UMA das duas. Elas ficam só no servidor (proxy), nunca no navegador.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Notificações no celular (opcional). Gere com:  npm run chaves
# A chave PRIVADA é secreta: só aqui e nas variáveis da Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://cantinho-red.vercel.app
